# MSME Pilot production frontend environment.
# Copy this file to .env.production on the VPS or CI before running npm run build.
#
# Only frontend-safe Vite variables belong here.
# Never include APPWRITE_API_KEY.
# Never include OPENAI_API_KEY.
# Never create VITE_APPWRITE_API_KEY.
# Never create VITE_OPENAI_API_KEY.
# .env.production must not be committed.

VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a4b9c4c001d2015e28a
VITE_APPWRITE_PARSE_INVOICE_FUNCTION_ID=parse_invoice_ai
VITE_APPWRITE_AI_ASSISTANT_FUNCTION_ID=ai_business_assistant
