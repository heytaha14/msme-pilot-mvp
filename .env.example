# Frontend-safe Appwrite values used by Vite.
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a4b9c4c001d2015e28a

# Backend/setup-only values for scripts/appwrite/setupSchema.js.
# APPWRITE_API_KEY must stay server-side/setup-only.
# Never expose APPWRITE_API_KEY in frontend code.
# Never create VITE_APPWRITE_API_KEY.
# Real .env files must not be committed.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a4b9c4c001d2015e28a
APPWRITE_DATABASE_ID=msme_pilot
APPWRITE_API_KEY=
