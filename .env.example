# Frontend-safe Appwrite config.
# These values may be exposed to Vite/browser code.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=

# Backend/setup-only Appwrite config.
# APPWRITE_API_KEY must only be used by server-side scripts or secure server environments.
# Never expose APPWRITE_API_KEY in frontend code.
# Never prefix the API key with VITE_.
# Copy this file to .env locally. Do not commit .env.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=msme_pilot
APPWRITE_API_KEY=
