# Frontend-safe Appwrite values used by Vite.
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a4b9c4c001d2015e28a
VITE_APPWRITE_PARSE_INVOICE_FUNCTION_ID=parse_invoice_ai
VITE_APPWRITE_AI_ASSISTANT_FUNCTION_ID=ai_business_assistant

# Backend/setup-only values for scripts/appwrite/setupSchema.js.
# APPWRITE_API_KEY must stay server-side/setup-only.
# Never expose APPWRITE_API_KEY in frontend code.
# Never create VITE_APPWRITE_API_KEY.
# Real .env files must not be committed.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a4b9c4c001d2015e28a
APPWRITE_DATABASE_ID=msme_pilot
APPWRITE_API_KEY=

# Appwrite Cloud Free allows one bucket per project.
# Keep true to use invoice_images as the single shared private upload bucket.
APPWRITE_FREE_PLAN=true

# Appwrite Function-only values for functions/parse-invoice-ai and functions/ai-business-assistant.
# OPENAI_API_KEY must live only in the Appwrite Function environment.
# APPWRITE_API_KEY must stay backend/function only.
# Never create VITE_OPENAI_API_KEY or VITE_APPWRITE_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_FALLBACK_MODELS=
OPENAI_TIMEOUT_MS=10000
